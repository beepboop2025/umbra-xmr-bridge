# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgres://umbra:umbra@localhost:5432/umbra

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth
SECRET_KEY=change-me-to-a-random-64-char-string

# Telegram
TELEGRAM_BOT_TOKEN=

# Monero
MONERO_RPC_URL=http://127.0.0.1:18082/json_rpc
MONERO_RPC_USER=
MONERO_RPC_PASS=

# TON
TON_API_URL=https://toncenter.com/api/v2
TON_API_KEY=

# EVM
ETH_RPC_URL=https://eth.llamarpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Bitcoin
BITCOIN_RPC_URL=http://127.0.0.1:8332
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=

# Rate Sources
COINGECKO_API_KEY=

# Bridge
BRIDGE_FEE_PERCENT=0.3
FAST_LANE_FEE_PERCENT=0.1
ORDER_EXPIRY_MINUTES=30
MPC_THRESHOLD=2
MPC_TOTAL_SIGNERS=3

# Rate Limiting
RATE_LIMIT_RATES=60
RATE_LIMIT_ORDERS=10
RATE_LIMIT_WS=5

# Proof Layer
# 32-byte hex seed for the Ed25519 receipt/checkpoint signing key.
# Leave empty to derive deterministically from SECRET_KEY (fine for dev;
# in production set an independent seed so key custody can be separated).
ATTESTATION_SECRET_KEY=
# How often the audit log is sealed into a signed Merkle checkpoint (seconds).
TRANSPARENCY_SEAL_INTERVAL_SECS=300
# Warrant-canary statement served (signed + freshness-bound) at /v1/proof/canary.
#CANARY_STATEMENT=

# Sentinel (circuit breaker). Trips pause NEW order intake only.
SENTINEL_ENABLED=true
SENTINEL_CHECK_INTERVAL_SECS=30
SENTINEL_MAX_ORDERS_PER_5M=60
SENTINEL_MAX_FAILURES_PER_15M=10
SENTINEL_RATE_DIVERGENCE_PERCENT=5.0
# Per-chain hourly outbound caps in native units, e.g. XMR:1000,BTC:20
# Unlisted chains use conservative built-in defaults.
SENTINEL_OUTFLOW_CAPS=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
RUST_LOG=umbra=debug,tower_http=debug
