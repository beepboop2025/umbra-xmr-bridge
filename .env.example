# Local / full-stack dev environment for docker-compose.yml.
# Copy to .env and fill in:  cp .env.example .env
# (Production uses a separate file — see deploy/.env.production.example.)

# Required by docker-compose.yml (it refuses to start without these)
POSTGRES_USER=umbra
POSTGRES_PASSWORD=change-me-strong        # openssl rand -hex 16
POSTGRES_DB=umbra
SECRET_KEY=change-me-64-hex-chars         # openssl rand -hex 32
GRAFANA_PASSWORD=change-me                 # Grafana admin login

# Shared X-API-Key between the API and the risk engine (compose reads RISK_API_KEY)
RISK_API_KEY=

# Proof layer / sentinel (safe defaults)
PQ_SIGNATURES_ENABLED=true
SENTINEL_ENABLED=true
SENTINEL_OUTFLOW_CAPS=
CANARY_STATEMENT=

# Optional: Telegram bot + blockchain RPCs (leave blank for a UI-only local run)
TELEGRAM_BOT_TOKEN=
MONERO_RPC_URL=
ETH_RPC_URL=
BITCOIN_RPC_URL=
SOLANA_RPC_URL=
TON_API_URL=
EVM_DEPOSIT_ADDRESS=
TON_DEPOSIT_ADDRESS=
SOL_DEPOSIT_ADDRESS=
