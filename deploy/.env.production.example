# ---------------------------------------------------------------------------
# Umbra production environment — copy to ../.env.production and fill in.
#   cp deploy/.env.production.example .env.production
# Never commit .env.production (it is gitignored). Keep a backup in a secret
# manager, not in this repo.
# ---------------------------------------------------------------------------

# === Required: edge / TLS ===
UMBRA_DOMAIN=umbra-xmr.com
ACME_EMAIL=you@example.com          # Let's Encrypt expiry notices go here

# === Required: core secrets ===
# Generate each with:  openssl rand -hex 32
POSTGRES_USER=umbra
POSTGRES_PASSWORD=                   # REQUIRED — strong random
POSTGRES_DB=umbra
SECRET_KEY=                          # REQUIRED — 64 hex chars
RISK_API_KEY=                        # REQUIRED — shared X-API-Key between API and risk engine

# === Proof layer (recommended in production) ===
# Independent 32-byte hex seeds so receipt-signing key custody is separate from
# SECRET_KEY. If left empty, keys are derived deterministically from SECRET_KEY
# (works, but rotating SECRET_KEY would then also rotate your signing identity).
ATTESTATION_SECRET_KEY=              # openssl rand -hex 32
ATTESTATION_PQ_SEED=                 # openssl rand -hex 32
PQ_SIGNATURES_ENABLED=true
# Optional signed warrant canary shown at /v1/proof/canary:
CANARY_STATEMENT=

# === Sentinel circuit breaker ===
SENTINEL_ENABLED=true
# Per-chain hourly outbound caps in native units — the volume at which the
# bridge halts NEW intake. Tune to your real liquidity + risk tolerance:
# too low = nuisance halts, too high = a drain slips through before it trips.
# Unlisted chains use conservative built-in defaults.
# Example: XMR:1000,BTC:20,ETH:200,TON:100000,SOL:10000
SENTINEL_OUTFLOW_CAPS=

# === Telegram bot (only needed if you deploy with --profile bot) ===
TELEGRAM_BOT_TOKEN=

# === Blockchain RPCs + hot deposit addresses ===
# The stack boots without these, but a chain cannot process real swaps until its
# RPC + deposit address are set. Fill in only the chains you are launching.
MONERO_RPC_URL=
MONERO_RPC_USER=
MONERO_RPC_PASS=
TON_API_URL=https://toncenter.com/api/v2
TON_API_KEY=
ETH_RPC_URL=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
SOLANA_RPC_URL=
BITCOIN_RPC_URL=
BITCOIN_RPC_USER=
BITCOIN_RPC_PASS=
EVM_DEPOSIT_ADDRESS=
TON_DEPOSIT_ADDRESS=
SOL_DEPOSIT_ADDRESS=

# === Risk engine thresholds (optional overrides) ===
RISK_MAX_SINGLE_ORDER_USD=50000
RISK_MAX_DAILY_VOLUME_USD=500000
RISK_MAX_CHAIN_EXPOSURE_PCT=40
RISK_ANOMALY_Z_THRESHOLD=2.5
